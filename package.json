  {
  "name": "zksync-dapp",
  "version": "1.0.0",
  "description": "zkSync Era dApp - A comprehensive Layer 2 blockchain application",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:testnet": "hardhat deploy-zksync --script deploy.ts --network zkSyncTestnet",
    "deploy:local": "hardhat deploy-zksync --script deploy.ts",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "test": "hardhat test --network localNode",
    "test:local": "bash scripts/run-tests.sh",
    "node:start": "hardhat node-zksync",
    "lint": "hardhat check"
  },
  "dependencies": {
    "undici": "^6.21.1",
    "zksync-ethers": "^6.21.2"
  },
  "devDependencies": {
    "@matterlabs/hardhat-zksync": "latest",
    "@matterlabs/hardhat-zksync-deploy": "latest",
    "@matterlabs/hardhat-zksync-solc": "latest",
    "@matterlabs/hardhat-zksync-verify": "latest",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "chai": "^5.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.12.0",
    "hardhat": "latest",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
